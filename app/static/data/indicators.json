{
  "fundamental": {
    "name": "基本面指标",
    "icon": "📊",
    "categories": [
      {
        "name": "估值类",
        "items": [
          {
            "id": "pe",
            "name": "市盈率",
            "symbol": "PE",
            "formula": "股价 ÷ 每股收益 (EPS)",
            "meaning": "衡量投资者愿意为每1元利润支付的价格。PE=20表示愿意用20元买1元利润。",
            "reference": {
              "low": "< 15：低估（便宜）",
              "mid": "15-25：合理估值",
              "high": "> 25：高估（贵）"
            },
            "warnings": [
              "亏损股 PE 无意义",
              "周期股在PE最低时可能见顶",
              "需与行业平均PE对比"
            ],
            "example": "贵州茅台 PE=45，行业平均=30，估值偏高但品牌溢价支撑",
            "related": ["pb", "peg"]
          },
          {
            "id": "pb",
            "name": "市净率",
            "symbol": "PB",
            "formula": "股价 ÷ 每股净资产",
            "meaning": "衡量股价相对于公司账面价值的溢价程度。PB=1表示股价等于净资产。",
            "reference": {
              "low": "< 1：破净（可能低估）",
              "mid": "1-3：合理区间",
              "high": "> 3：高溢价"
            },
            "warnings": [
              "银行股PB普遍较低（0.5-1）",
              "科技股PB普遍较高（3-10）",
              "需结合ROE看，高ROE可支撑高PB"
            ],
            "example": "工商银行 PB=0.6，属于破净股；腾讯 PB=8，高成长支撑",
            "related": ["pe", "roe"]
          },
          {
            "id": "peg",
            "name": "市盈率相对盈利增长比率",
            "symbol": "PEG",
            "formula": "PE ÷ 净利润增长率（%）",
            "meaning": "将估值与成长性结合，判断高PE是否合理。PEG=1表示估值与增长匹配。",
            "reference": {
              "low": "< 1：低估（增长被低估）",
              "mid": "= 1：合理",
              "high": "> 1：高估（增长跟不上估值）"
            },
            "warnings": [
              "增长率需用预期值，预测有误差",
              "不适用于亏损股",
              "高增长不可持续时PEG失真"
            ],
            "example": "PE=30，增长率30%，PEG=1合理；若增长率50%，PEG=0.6低估",
            "related": ["pe"]
          }
        ]
      },
      {
        "name": "盈利能力",
        "items": [
          {
            "id": "roe",
            "name": "净资产收益率",
            "symbol": "ROE",
            "formula": "净利润 ÷ 净资产 × 100%",
            "meaning": "衡量公司用股东资金赚钱的效率。ROE=15%表示每100元股东资本赚15元。",
            "reference": {
              "low": "< 8%：盈利能力弱",
              "mid": "8%-15%：良好",
              "high": "> 15%：优秀（巴菲特标准）"
            },
            "warnings": [
              "高负债可人为拉高ROE",
              "需看ROE持续性（连续3年>15%更佳）",
              "行业间ROE差异大"
            ],
            "example": "贵州茅台 ROE=30%，连续10年>25%，盈利能力极强",
            "related": ["roa", "pe"]
          },
          {
            "id": "roa",
            "name": "总资产收益率",
            "symbol": "ROA",
            "formula": "净利润 ÷ 总资产 × 100%",
            "meaning": "衡量公司用全部资产（含负债）赚钱的能力，比ROE更保守。",
            "reference": {
              "low": "< 3%：资产利用效率低",
              "mid": "3%-8%：良好",
              "high": "> 8%：优秀"
            },
            "warnings": [
              "轻资产公司ROA通常高于重资产",
              "金融业ROA普遍较低（高杠杆）",
              "需与ROE对比看杠杆水平"
            ],
            "example": "腾讯 ROA=12%，轻资产模式资产利用效率高",
            "related": ["roe"]
          }
        ]
      }
    ]
  },
  "technical": {
    "name": "技术面指标",
    "icon": "📈",
    "categories": [
      {
        "name": "趋势指标",
        "items": [
          {
            "id": "ma",
            "name": "移动平均线",
            "symbol": "MA",
            "formula": "N日收盘价之和 ÷ N",
            "meaning": "平滑价格波动，显示趋势方向。MA5短期，MA20中期，MA250长期（年线）。",
            "reference": {
              "low": "价格在MA下方：弱势",
              "mid": "价格围绕MA：震荡",
              "high": "价格在MA上方：强势"
            },
            "warnings": [
              "滞后性指标，不能预测未来",
              "震荡市频繁假突破",
              "需多周期共振判断"
            ],
            "example": "MA5上穿MA20（金叉）：短期趋势转强；MA250：牛熊分界线",
            "related": ["ema", "macd"]
          },
          {
            "id": "macd",
            "name": "平滑异同移动平均线",
            "symbol": "MACD",
            "formula": "DIF=EMA12-EMA26\nDEA=DIF的9日EMA\n柱状图=DIF-DEA",
            "meaning": "判断趋势方向和强度。金叉买入，死叉卖出，零轴上方为多头市场。",
            "reference": {
              "low": "DIF<DEA<0：空头趋势",
              "mid": "DIF≈DEA：震荡盘整",
              "high": "DIF>DEA>0：多头趋势"
            },
            "warnings": [
              "震荡市频繁假信号",
              "滞后性较强，不适合短线",
              "需配合成交量判断"
            ],
            "example": "DIF上穿DEA且都在零轴上方：强买入信号",
            "related": ["ma"]
          }
        ]
      },
      {
        "name": "震荡指标",
        "items": [
          {
            "id": "rsi",
            "name": "相对强弱指数",
            "symbol": "RSI",
            "formula": "RSI=100-100÷(1+RS)\nRS=N日平均涨幅÷N日平均跌幅",
            "meaning": "衡量买卖力量对比，判断超买超卖。RSI(6)短期，RSI(14)中期。",
            "reference": {
              "low": "<30：超卖（可能反弹）",
              "mid": "30-70：正常区间",
              "high": ">70：超买（可能回调）"
            },
            "warnings": [
              "强势股可长期处于超买区",
              "弱势股可长期处于超卖区",
              "需配合趋势判断"
            ],
            "example": "RSI从30以下回升：买入信号；从70以上回落：卖出信号",
            "related": ["kdj"]
          },
          {
            "id": "kdj",
            "name": "随机指标",
            "symbol": "KDJ",
            "formula": "RSV=(C-L9)÷(H9-L9)×100\nK=RSV的3日平滑\nD=K的3日平滑\nJ=3K-2D",
            "meaning": "比RSI更敏感的超买超卖指标，适合短线交易。J值最敏感。",
            "reference": {
              "low": "K,D<20：超卖区",
              "mid": "20-80：正常区间",
              "high": "K,D>80：超买区"
            },
            "warnings": [
              "J值可超过100或低于0",
              "震荡市有效，趋势市失真",
              "金叉死叉频繁，需过滤"
            ],
            "example": "KDJ金叉且J值从负值回升：强买入信号",
            "related": ["rsi"]
          }
        ]
      }
    ]
  },
